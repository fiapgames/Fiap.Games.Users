@User.Games.Fiap_HostAddress = http://localhost:5106
@accessToken = paste-access-token-here
@refreshToken = paste-refresh-token-here
@userId = paste-user-id-here

POST {{User.Games.Fiap_HostAddress}}/api/users
Content-Type: application/json

{
  "nome": "Test User",
  "email": "test.user@example.com",
  "password": "Password123"
}

###

POST {{User.Games.Fiap_HostAddress}}/api/users/login
Content-Type: application/json

{
  "email": "test.user@example.com",
  "password": "Password123"
}

###

POST {{User.Games.Fiap_HostAddress}}/api/users/refresh
Content-Type: application/json

{
  "refreshToken": "{{refreshToken}}"
}

###

GET {{User.Games.Fiap_HostAddress}}/api/users?page=1&pageSize=20
Authorization: Bearer {{accessToken}}
Accept: application/json

###

GET {{User.Games.Fiap_HostAddress}}/api/users/{{userId}}
Authorization: Bearer {{accessToken}}
Accept: application/json

###

GET {{User.Games.Fiap_HostAddress}}/health
Accept: application/json
